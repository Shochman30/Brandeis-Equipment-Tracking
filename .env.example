# Copy to .env and fill in. Never commit .env.

# Public addresses (Cloudflare tunnel hostnames)
TRACKER_HOST=tracker.example.com
AUTHENTIK_HOST=auth.example.com

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token
CLOUDFLARE_TUNNEL_TOKEN=

# Authentik database password and secret key. Generate with:
#   openssl rand -hex 32     (PG_PASS)
#   openssl rand -hex 50     (AUTHENTIK_SECRET_KEY)
PG_PASS=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# Optional: email, so Authentik can send password-reset and invitation emails
# AUTHENTIK_EMAIL__HOST=smtp.example.com
# AUTHENTIK_EMAIL__PORT=587
# AUTHENTIK_EMAIL__USERNAME=
# AUTHENTIK_EMAIL__PASSWORD=
# AUTHENTIK_EMAIL__USE_TLS=true
# AUTHENTIK_EMAIL__FROM=tracker@example.com

# Only if Authentik keeps restarting with "Address family not supported by
# protocol" in its log (IPv6 is turned off on this Linux machine):
# AUTHENTIK_LISTEN__HTTP=0.0.0.0:9000
# AUTHENTIK_LISTEN__HTTPS=0.0.0.0:9443
# AUTHENTIK_LISTEN__METRICS=0.0.0.0:9300

# Tracker roles (Authentik group names, comma separated)
EDITOR_GROUPS=tracker-editors
OWNER_GROUPS=tracker-owners,authentik Admins
